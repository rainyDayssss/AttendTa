@model ASI.Basecode.Services.ServiceModels.AccountRequestListViewModel
@{ ViewData["Title"] = "Account requests"; }
<div class="container py-4">
    <h1>Pending account requests</h1>
    <form method="get" asp-action="Index" class="mb-3"><label for="search">Search name, email, or student number</label><input id="search" name="search" value="@Model.Search" class="form-control"/><button type="submit" class="btn btn-secondary mt-2">Search</button></form>
    <p>@Model.TotalCount pending request(s)</p>
    @if (Model.Items.Count == 0) { <p>No pending requests.</p> }
    @foreach (var request in Model.Items)
    {
        <section class="card mb-3"><div class="card-body">
            <h2 class="h5">@request.FullName</h2>
            <p>@request.Email · @request.StudentNumber · @request.Course, Year @request.YearLevel, @request.Section · @request.MobileNumber</p>
            <p>Requested @request.RequestedAt.ToString("yyyy-MM-dd HH:mm 'UTC'")</p>
            <form asp-action="Approve" method="post" class="d-inline"><input type="hidden" name="id" value="@request.RequestId"/><button class="btn btn-success" type="submit">Approve</button></form>
            <form asp-action="Reject" method="post" class="mt-2"><input type="hidden" name="RequestId" value="@request.RequestId"/><label for="reason-@request.RequestId">Rejection reason</label><input id="reason-@request.RequestId" name="ReviewNotes" required maxlength="1000" class="form-control"/><button class="btn btn-danger mt-2" type="submit">Reject</button></form>
        </div></section>
    }
    <nav aria-label="Account request pages" class="d-flex gap-3">
        @if (Model.Page > 1) { <a asp-action="Index" asp-route-page="@(Model.Page - 1)" asp-route-search="@Model.Search">Previous</a> }
        <span>Page @Model.Page of @Model.TotalPages (@Model.PageSize per page)</span>
        @if (Model.Page < Model.TotalPages) { <a asp-action="Index" asp-route-page="@(Model.Page + 1)" asp-route-search="@Model.Search">Next</a> }
    </nav>
</div>
