@model CertificateViewerViewModel
@{
    ViewData["Title"] = "Certificate";
}

<div class="page-heading">
    <div>
        <h1>Certificate</h1>
        <p class="muted">@Model.MemberName · @Model.EventTitle</p>
    </div>
    <a asp-action="Index" asp-route-eventId="@Model.EventId" asp-route-tab="issued" class="button button-secondary">Back to certificates</a>
</div>

@if (ViewData["DocumentError"] is string error)
{
    <div class="notice notice-error" role="alert">
        <p>@error</p>
        <a asp-action="Pdf" asp-route-id="@Model.CertificateId">Try opening the document again</a>
    </div>
}
else
{
    <div class="section-head certificate-toolbar">
        <span class="numeric">@Model.CertificateNumber</span>
        <div class="certificate-toolbar-actions">
            <a asp-action="Pdf" asp-route-id="@Model.CertificateId" class="button button-secondary" target="_blank" rel="noopener">Open PDF<span class="ledger-sr-only"> in a new tab</span></a>
            <a asp-action="Pdf" asp-route-id="@Model.CertificateId" asp-route-download="true" class="button button-primary">Download PDF</a>
        </div>
    </div>
    <p class="muted">If the document does not appear below, use Open PDF or Download PDF.</p>
    <section class="certificate-viewer" aria-label="Certificate document">
        <iframe src="@Url.Action("Pdf", new { id = Model.CertificateId })" title="Certificate PDF for @Model.MemberName"></iframe>
    </section>
}
