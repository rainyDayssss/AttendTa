@model PassesViewModel
@{
    ViewData["Title"] = "Door Passes";
}

<div class="page-heading">
    <div>
        <h1>Door Passes</h1>
        <p class="muted">Show the code at the door for each event you are confirmed to attend.</p>
    </div>
</div>

<section class="passes-section" aria-labelledby="active-passes-heading">
    <div class="section-head">
        <h2 id="active-passes-heading">Active passes</h2>
    </div>
    @if (Model.Active.Count == 0)
    {
        <div class="empty-panel"><p>No active passes. A pass appears here once a registration is confirmed for an upcoming event.</p></div>
    }
    else
    {
        <div class="pass-grid">
            @foreach (var pass in Model.Active)
            {
                <partial name="~/Views/MyEvents/_PassPartial.cshtml" model="pass" />
            }
        </div>
    }
</section>

<section class="passes-section" aria-labelledby="past-passes-heading">
    <div class="section-head">
        <h2 id="past-passes-heading">Past passes</h2>
    </div>
    @if (Model.Past.Count == 0)
    {
        <div class="empty-panel"><p>No past passes yet.</p></div>
    }
    else
    {
        <div class="pass-grid">
            @foreach (var pass in Model.Past)
            {
                <partial name="~/Views/MyEvents/_PassPartial.cshtml" model="pass" />
            }
        </div>
    }
</section>
