@model MemberViewModel
@{
    ViewData["Title"] = "My Member Profile";
    var initials = string.Concat(
        (Model.FullName ?? string.Empty)
            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
            .Take(2)
            .Select(part => char.ToUpperInvariant(part[0])));
    var active = Model.Status == "active";
}

<div class="page-heading">
    <div>
        <h1>My Member Profile</h1>
        <p class="muted">Review the account, academic and membership details linked to your account.</p>
    </div>
</div>

<section class="identity-strip" aria-label="Member identity">
    <span class="identity-avatar" aria-hidden="true">@initials</span>
    <div class="identity-text">
        <p class="identity-name">@Model.FullName</p>
        <p class="identity-meta">@Model.Email · @Model.StudentNumber</p>
    </div>
    <span class="badge @(active ? "badge-active" : "badge-inactive")">@(active ? "Active" : "Inactive")</span>
</section>

<p class="notice notice-amber" role="status">Profile details are managed by an organization officer. Contact one to request a correction.</p>

@if (!active)
{
    <p class="notice notice-amber" role="status">Your membership is inactive. You can still sign in, review your history and download issued certificates, but you cannot register for new events. Contact an officer to reactivate your membership.</p>
}

<section class="panel" aria-labelledby="profile-account-heading">
    <h2 id="profile-account-heading">Account</h2>
    <dl class="profile-details">
        <div>
            <dt>Full name</dt>
            <dd>@Model.FullName</dd>
        </div>
        <div>
            <dt>Email</dt>
            <dd>@Model.Email</dd>
        </div>
    </dl>
</section>

<section class="panel" aria-labelledby="profile-academic-heading">
    <h2 id="profile-academic-heading">Academic details</h2>
    <dl class="profile-details">
        <div>
            <dt>Student number</dt>
            <dd>@Model.StudentNumber</dd>
        </div>
        <div>
            <dt>Course</dt>
            <dd>@Model.Course</dd>
        </div>
        <div>
            <dt>Year level</dt>
            <dd>@Model.YearLevel</dd>
        </div>
        <div>
            <dt>Section</dt>
            <dd>@Model.Section</dd>
        </div>
    </dl>
</section>

<section class="panel" aria-labelledby="profile-membership-heading">
    <h2 id="profile-membership-heading">Membership</h2>
    <dl class="profile-details">
        <div>
            <dt>Mobile number</dt>
            <dd>@Model.MobileNumber</dd>
        </div>
        <div>
            <dt>Membership type</dt>
            <dd>@Model.MembershipType</dd>
        </div>
        <div>
            <dt>Membership status</dt>
            <dd>@(active ? "Active" : "Inactive")</dd>
        </div>
    </dl>
</section>
