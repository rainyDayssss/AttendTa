@model EventCancelViewModel
@{
    ViewData["Title"] = "Cancel Event";
}

<div class="page-heading">
    <h2>Cancel event</h2>
    <a asp-action="Index" class="button button-secondary">Back to events</a>
</div>

<h3>@Model.Title</h3>
<p class="muted">Status: @Model.StatusLabel</p>
<p>Starts: @ManilaTimeFormatter.Format(Model.StartsAt)</p>

<p>Cancelling this event also cancels every pending, confirmed and waitlisted registration and closes check-in. This cannot be undone.</p>

<form asp-action="Cancel" method="post">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <input type="hidden" asp-for="EventId" />
    <div class="field">
        <label asp-for="Reason" class="field-label">Reason</label>
        <textarea asp-for="Reason" class="field-control" rows="3" aria-describedby="Reason-validation"></textarea>
        <span id="Reason-validation" asp-validation-for="Reason" class="field-error"></span>
    </div>
    <button type="submit" class="button button-primary">Cancel event</button>
    <a asp-action="Index" class="button button-secondary">Keep event</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
