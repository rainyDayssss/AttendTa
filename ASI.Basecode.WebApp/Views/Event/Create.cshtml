@model EventViewModel
@{
    ViewData["Title"] = "Create Draft Event";
}

<div class="page-heading">
    <div>
        <h1>Create draft event</h1>
        <p>Drafts are visible to Management only. Save the draft, add a cover image, then publish it from the Events list.</p>
    </div>
</div>

<form asp-action="Create" method="post" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="button button-primary">Save draft</button>
        <a asp-action="Index" class="button button-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
