@model PagedResult<EventTypeViewModel>
@{
    ViewData["Title"] = "Event Classifications";
    var statusFilter = ViewBag.Status as string;
}

<div class="page-heading">
    <h1>Event Classifications</h1>
    <a asp-action="Create" class="button button-primary">New Event Type</a>
</div>

<nav class="filter-tabs" aria-label="Event type status">
    <a class="filter-tab" asp-action="Index" aria-current="@(string.IsNullOrEmpty(statusFilter) ? "page" : null)">All</a>
    <a class="filter-tab" asp-action="Index" asp-route-status="active" aria-current="@(statusFilter == "active" ? "page" : null)">Active</a>
    <a class="filter-tab" asp-action="Index" asp-route-status="inactive" aria-current="@(statusFilter == "inactive" ? "page" : null)">Inactive</a>
</nav>

@if (Model.Items.Count == 0)
{
    <div class="table-scroll" role="region" aria-label="Event Type table" tabindex="0">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Type Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td colspan="4" class="empty-state">
                        @if (string.IsNullOrEmpty(statusFilter))
                        {
                            <text>No event types yet. Use "New Event Type" to create the first one.</text>
                        }
                        else
                        {
                            <text>No @statusFilter event types.</text>
                        }
                    </td>
                </tr>
            </tbody>
        </table>
    </div>
}
else
{
    <div class="table-scroll" role="region" aria-label="Event Type table" tabindex="0">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Type Name</th>
                    <th scope="col">Description</th>
                    <th scope="col">Status</th>
                    <th scope="col" class="actions">Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var eventType in Model.Items)
                {
                    <tr data-type-id="@eventType.TypeId">
                        <td>@eventType.TypeName</td>
                        <td>@eventType.Description</td>
                        <td><span class="badge @(eventType.IsActive ? "badge-active" : "badge-inactive")">@(eventType.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="actions">
                            <div class="row-actions">
                                <a asp-action="Edit" asp-route-id="@eventType.TypeId" class="button button-small button-secondary">Edit</a>
                                <form asp-action="ToggleActive" asp-route-id="@eventType.TypeId" method="post" class="inline-form">
                                    <input type="hidden" name="page" value="@Model.PageNumber" />
                                    <button type="submit" class="button button-small button-secondary">@(eventType.IsActive ? "Deactivate" : "Activate")</button>
                                </form>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>

    <partial name="_Pager" model="Model" />
}

<partial name="_ResultCount" model="Model" />
