@model string
@{ var fieldName = Model == "ConfirmPassword" ? "confirmation password" : "password"; }
<button type="button" class="password-toggle" hidden data-password-toggle="@Model" aria-controls="@Model" aria-pressed="false" aria-label="Show @fieldName">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false">
        <path d="M2 12s3.6-6 10-6 10 6 10 6-3.6 6-10 6S2 12 2 12Z" />
        <circle cx="12" cy="12" r="3" />
        <path class="password-toggle-slash" d="M4 4l16 16" />
    </svg>
</button>
