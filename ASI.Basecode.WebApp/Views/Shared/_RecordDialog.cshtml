<dialog id="record-dialog" class="record-dialog" aria-labelledby="record-dialog-title" aria-describedby="record-dialog-description">
    <header class="record-dialog-header">
        <div class="record-dialog-heading">
            <h2 id="record-dialog-title">Record editor</h2>
            <p class="record-dialog-subtitle" data-record-subtitle hidden></p>
        </div>
        <button type="button" class="record-dialog-close" data-record-close aria-label="Close editor">
            <svg width="16" height="16" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
                <path d="M4 4l8 8M12 4l-8 8" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" />
            </svg>
        </button>
    </header>
    <p id="record-dialog-description">Required fields are marked with an asterisk.</p>
    <div data-record-message role="status" tabindex="-1"></div>
    <div data-record-body></div>
    <div data-record-recovery hidden>
        <button type="button" class="button button-secondary" data-record-retry>Retry loading</button>
        <a class="button button-secondary" data-record-fallback>Open full page</a>
    </div>
</dialog>
