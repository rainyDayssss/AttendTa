@using ASI.Basecode.Resources.Constants
@{
    var authenticated = User.Identity?.IsAuthenticated == true;
    var management = User.IsInRole(RoleCodes.Admin) || User.IsInRole(RoleCodes.Officer);
    var role = User.IsInRole(RoleCodes.Admin) ? "Administrator" : User.IsInRole(RoleCodes.Officer) ? "Officer" : "Member";
}
<header class="shell-header @(management ? "management-header" : "")">
    <div class="brand-row">
        @if (authenticated)
        {
            <a class="brand" asp-controller="Home" asp-action="Index"><img class="brand-mark" src="~/img/attendta-logo.jpg" alt="" /><span>AttendTa<small>University of Cebu</small></span></a>
        }
        else
        {
            <div class="brand"><img class="brand-mark" src="~/img/attendta-logo.jpg" alt="" /><span>AttendTa<small>University of Cebu</small></span></div>
        }
        @if (authenticated)
        {
            <details class="mobile-menu">
                <summary>Menu</summary>
                <nav aria-label="Mobile navigation">
                    <partial name="_NavLinks" />
                    <div class="account-name">@User.Identity?.Name <span>@role</span></div>
                    <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="nav-logout">Sign out</button></form>
                </nav>
            </details>
        }
    </div>
    @if (authenticated)
    {
        <nav class="desktop-nav" aria-label="Main navigation">
            <partial name="_NavLinks" />
            <div class="account-name">@User.Identity?.Name <span>@role</span></div>
            <form asp-controller="Account" asp-action="Logout" method="post"><button type="submit" class="nav-logout">Sign out</button></form>
        </nav>
    }
</header>
