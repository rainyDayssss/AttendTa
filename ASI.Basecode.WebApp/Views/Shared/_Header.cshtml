@using Microsoft.AspNetCore.Http
@inject IHttpContextAccessor HttpContextAccessor
<header class="@((ViewBag.LoginView == true) ? "hide-navbar" : "")">
    <div class="logosec hover-pointer">
        <img src="~/img/asi-logo-invert.svg"
             style="width: 185px;" alt="logo"
             onclick="window.location.href = '@Url.Action("Index", "Home")';">
    </div>
    <nav class="header-nav" style="display:flex; gap:20px; align-items:center;">
        <a href="@Url.Action("Index", "Member")" style="color:#fff;">Members</a>
        <a href="@Url.Action("Index", "EventType")" style="color:#fff;">Event Types</a>
        <a href="@Url.Action("Index", "Venue")" style="color:#fff;">Venues</a>
        @if (User.IsInRole("admin") || User.IsInRole("officer"))
        {
            <a href="@Url.Action("Index", "AccountRequest")" style="color:#fff;">Account Requests</a>
        }
    </nav>
    <div class="logosec">
        @User.Identity?.Name
        <div class="mr-20 hover-pointer" style="position: relative">
            <div class="dp">
                <img src="~/img/profile-logo.png"
                     class="dpicn hover-pointer"
                     alt="dp">
            </div>
            <div class="dropdown">
                <ul>
                    <li>
                        <i class="fa-solid fa-gear"></i>
                        <a href="#">Settings</a>
                    </li>
                    <li>
                        <i class="fa-solid fa-right-from-bracket"></i>
                        <form asp-action="SignOutUser" asp-controller="Account" method="post"><button type="submit" class="btn btn-link p-0">Logout</button></form>
                    </li>
                </ul>
            </div>
        </div>
    </div>
</header>
