@model MyEventsAttendanceTabViewModel
@if (Model.Rows.Count > 0)
{
    <div class="table-scroll attendance-history" role="region" aria-label="Attendance history" tabindex="0">
        <table class="data-table">
            <thead>
                <tr>
                    <th scope="col">Event</th>
                    <th scope="col">Recorded</th>
                    <th scope="col">Method</th>
                    <th scope="col">State</th>
                    <th scope="col">Reason</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var row in Model.Rows)
                {
                    <tr data-attendance-id="@row.AttendanceId">
                        <th scope="row" data-label="Event">@row.EventTitle</th>
                        <td data-label="Recorded" class="numeric cell-date">@ManilaTimeFormatter.Format(row.RecordedAt)</td>
                        <td data-label="Method">@row.CheckInMethodLabel</td>
                        <td data-label="State">
                            @if (row.IsInvalidated)
                            {
                                <span class="badge badge-inactive">Invalidated</span>
                            }
                            else
                            {
                                <span class="badge badge-active">Valid</span>
                            }
                        </td>
                        <td data-label="Reason"><partial name="_ReasonContent" model="@(row.IsInvalidated ? row.InvalidationReason ?? string.Empty : string.Empty)" /></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
