@model MemberViewModel
@{
    ViewData["Title"] = "Edit Member";
}

<div class="page-heading">
    <h1>Edit Member</h1>
</div>

<form asp-action="Edit" method="post" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <input type="hidden" asp-for="MemberId" />
    <div class="field">
        <label asp-for="Email" class="field-label">Email</label>
        <input asp-for="Email" class="field-control" readonly aria-readonly="true" aria-describedby="Email-help" />
        <small id="Email-help" class="muted">The sign-in email belongs to the account and cannot be changed here.</small>
    </div>
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="button button-primary">Save</button>
        <a asp-action="Index" class="button button-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
