@model MemberViewModel

<fieldset>
    <legend>Identity</legend>
    <div class="field">
        <label asp-for="FullName" class="field-label">Full name <span class="required" aria-hidden="true">*</span></label>
        <input asp-for="FullName" aria-describedby="FullName-validation" class="field-control" required aria-required="true" />
        <span id="FullName-validation" asp-validation-for="FullName" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="StudentNumber" class="field-label">Student number <span class="required" aria-hidden="true">*</span></label>
        <input asp-for="StudentNumber" aria-describedby="StudentNumber-validation" class="field-control" required aria-required="true" />
        <span id="StudentNumber-validation" asp-validation-for="StudentNumber" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="StudentNumberCorrectionReason" class="field-label">Reason for student-number correction</label>
        <textarea asp-for="StudentNumberCorrectionReason" aria-describedby="StudentNumberCorrectionReason-validation" class="field-control" rows="3"></textarea>
        <span id="StudentNumberCorrectionReason-validation" asp-validation-for="StudentNumberCorrectionReason" class="field-error"></span>
    </div>
</fieldset>

<fieldset>
    <legend>Academic details</legend>
    <div class="field">
        <label asp-for="Course" class="field-label">Course <span class="required" aria-hidden="true">*</span></label>
        <input asp-for="Course" aria-describedby="Course-validation" class="field-control" required aria-required="true" />
        <span id="Course-validation" asp-validation-for="Course" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="YearLevel" class="field-label">Year level <span class="required" aria-hidden="true">*</span></label>
        <input asp-for="YearLevel" aria-describedby="YearLevel-validation" type="number" class="field-control" min="1" required aria-required="true" />
        <span id="YearLevel-validation" asp-validation-for="YearLevel" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="Section" class="field-label">Section <span class="required" aria-hidden="true">*</span></label>
        <input asp-for="Section" aria-describedby="Section-validation" class="field-control" required aria-required="true" />
        <span id="Section-validation" asp-validation-for="Section" class="field-error"></span>
    </div>
</fieldset>

<fieldset>
    <legend>Membership</legend>
    <div class="field">
        <label asp-for="MobileNumber" class="field-label">Mobile number</label>
        <input asp-for="MobileNumber" aria-describedby="MobileNumber-validation" class="field-control" />
        <span id="MobileNumber-validation" asp-validation-for="MobileNumber" class="field-error"></span>
    </div>
    <div class="field">
        <label asp-for="MembershipType" class="field-label">Membership type</label>
        <input asp-for="MembershipType" aria-describedby="MembershipType-validation" class="field-control" />
        <span id="MembershipType-validation" asp-validation-for="MembershipType" class="field-error"></span>
    </div>
    <p class="field-hint">Profile edits do not change existing registration details or issued certificates.</p>
</fieldset>
