@model VenueViewModel
@{
    ViewData["Title"] = "New Venue";
    ViewData["PhotoRequired"] = true;
}

<h1>New Venue</h1>

<form asp-action="Create" method="post" enctype="multipart/form-data" class="form-panel">
    <div asp-validation-summary="ModelOnly" class="validation-summary" role="alert"></div>
    <partial name="_Form" model="Model" />
    <div class="form-actions">
        <button type="submit" class="button button-primary">Save</button>
        <a asp-action="Index" class="button button-secondary">Cancel</a>
    </div>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/features/venue-photo.js" asp-append-version="true"></script>
}
